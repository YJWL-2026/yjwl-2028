# ============================================================
# 应急决策教学系统 - Systemd服务
# 部署时复制到 /etc/systemd/system/emergency-decision.service
# 然后执行: systemctl daemon-reload && systemctl enable --now emergency-decision
# ============================================================

[Unit]
Description=Emergency Decision Teaching System (Flask + Gunicorn)
After=network.target

[Service]
# 运行用户
User=www-data
Group=www-data

# 项目目录
WorkingDirectory=/opt/emergency-decision

# 虚拟环境路径
Environment="PATH=/opt/emergency-decision/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/opt/emergency-decision/src"
Environment="HOST=127.0.0.1"
Environment="PORT=5000"
Environment="FLASK_DEBUG=0"

# Gunicorn启动命令
ExecStart=/opt/emergency-decision/venv/bin/gunicorn \
    --workers 4 \
    --bind 127.0.0.1:5000 \
    --timeout 120 \
    --access-logfile /var/log/emergency-decision/access.log \
    --error-logfile /var/log/emergency-decision/error.log \
    wsgi:app

# 自动重启
Restart=always
RestartSec=5

# 安全限制
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
