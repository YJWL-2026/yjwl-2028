# WorkBuddy 工作目录（缓存/配置，不纳入版本管理）
.workbuddy/

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.venv/
venv/
env/

# 运行时临时文件
cookies.txt
token_resp.json
*.log

# 输出目录
output/

# 环境变量/密钥（避免泄露）
.env
.env.local

# IDE 配置
.vscode/
.idea/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 小程序构建产物
miniprogram/dist/
