/* pages/index/index.wxss */

.container {
  width: 100%;
  height: 100vh;
  position: relative;
}

web-view {
  width: 100%;
  height: 100vh;
}

/* 加载动画 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid rgba(127, 119, 221, 0.2);
  border-top: 6rpx solid #7F77DD;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #888;
}

/* 错误面板 */
.error-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 40rpx;
}

.error-icon {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  text-align: center;
  font-size: 60rpx;
  font-weight: bold;
  color: #F0997B;
  border: 4rpx solid #F0997B;
  border-radius: 50%;
  margin-bottom: 32rpx;
}

.error-title {
  font-size: 36rpx;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.error-desc {
  font-size: 28rpx;
  color: #888;
  margin-bottom: 48rpx;
}

.btn-primary {
  background: #534AB7;
  color: #ffffff;
  border: none;
  border-radius: 16rpx;
  padding: 24rpx 80rpx;
  font-size: 32rpx;
}
