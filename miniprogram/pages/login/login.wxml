<!--pages/login/login.wxml - 原生登录页-->
<view class="login-container">
  <!-- Logo和标题 -->
  <view class="header">
    <view class="logo-icon">
      <text class="logo-text">ED</text>
    </view>
    <text class="title">应急决策教学系统</text>
    <text class="subtitle">Emergency Decision Teaching</text>
  </view>

  <!-- 登录表单 -->
  <view class="form-card">
    <!-- 角色切换Tab -->
    <view class="tab-bar">
      <view class="tab {{activeTab === 'teacher' ? 'active' : ''}}" bindtap="switchTab" data-tab="teacher">
        <text>教师登录</text>
      </view>
      <view class="tab {{activeTab === 'student' ? 'active' : ''}}" bindtap="switchTab" data-tab="student">
        <text>学生登录</text>
      </view>
    </view>

    <!-- 输入框 -->
    <view class="input-group">
      <text class="input-label">账号</text>
      <input
        class="input"
        type="text"
        placeholder="请输入账号"
        placeholder-class="placeholder"
        value="{{username}}"
        bindinput="onUsernameInput"
      />
    </view>

    <view class="input-group">
      <text class="input-label">密码</text>
      <input
        class="input"
        type="text"
        password="{{true}}"
        placeholder="请输入密码"
        placeholder-class="placeholder"
        value="{{password}}"
        bindinput="onPasswordInput"
      />
    </view>

    <!-- 登录按钮 -->
    <button class="btn-login" bindtap="doLogin" loading="{{loggingIn}}" disabled="{{loggingIn}}">
      {{loggingIn ? '登录中...' : '登 录'}}
    </button>

    <!-- 演示账号 -->
    <view class="demo-accounts">
      <text class="demo-title">演示账号（点击快速填充）</text>
      <view class="demo-list" wx:if="{{activeTab === 'teacher'}}">
        <view class="demo-item" bindtap="fillDemo" data-user="teacher01" data-pass="teach123">
          <text class="demo-user">teacher01</text>
          <text class="demo-pass">/ teach123</text>
        </view>
        <view class="demo-item" bindtap="fillDemo" data-user="teacher02" data-pass="teach456">
          <text class="demo-user">teacher02</text>
          <text class="demo-pass">/ teach456</text>
        </view>
      </view>
      <view class="demo-list" wx:else>
        <view class="demo-item" bindtap="fillDemo" data-user="student01" data-pass="stud123">
          <text class="demo-user">student01</text>
          <text class="demo-pass">/ stud123</text>
        </view>
        <view class="demo-item" bindtap="fillDemo" data-user="student02" data-pass="stud456">
          <text class="demo-user">student02</text>
          <text class="demo-pass">/ stud456</text>
        </view>
        <view class="demo-item" bindtap="fillDemo" data-user="student03" data-pass="stud789">
          <text class="demo-user">student03</text>
          <text class="demo-pass">/ stud789</text>
        </view>
      </view>
    </view>
  </view>
</view>
