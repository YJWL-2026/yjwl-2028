/* pages/login/login.wxss - 登录页样式 */

.login-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f0f1e 0%, #1a1a2e 50%, #16213e 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx 40rpx;
  box-sizing: border-box;
}

/* 头部 */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #534AB7, #7F77DD);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.logo-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 500;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* 表单卡片 */
.form-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 40rpx;
  box-sizing: border-box;
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

/* Tab栏 */
.tab-bar {
  display: flex;
  margin-bottom: 40rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.05);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
  transition: all 0.3s;
}

.tab.active {
  background: linear-gradient(135deg, #534AB7, #7F77DD);
  color: #ffffff;
  font-weight: 500;
}

/* 输入框组 */
.input-group {
  margin-bottom: 32rpx;
}

.input-label {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 32rpx;
  box-sizing: border-box;
}

.placeholder {
  color: rgba(255, 255, 255, 0.3);
}

/* 登录按钮 */
.btn-login {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #534AB7, #7F77DD);
  color: #ffffff;
  border: none;
  border-radius: 16rpx;
  font-size: 34rpx;
  font-weight: 500;
  margin-top: 20rpx;
  margin-bottom: 40rpx;
}

.btn-login[disabled] {
  opacity: 0.5;
}

/* 演示账号 */
.demo-accounts {
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  padding-top: 24rpx;
}

.demo-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  display: block;
  margin-bottom: 16rpx;
}

.demo-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.demo-item {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 8rpx;
}

.demo-user {
  font-size: 28rpx;
  color: #AFA9EC;
  font-weight: 500;
}

.demo-pass {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-left: 16rpx;
}
